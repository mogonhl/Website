# Twitter API Configuration
# 1. Go to https://developer.twitter.com/en/portal/dashboard
# 2. Create a new app or select an existing one
# 3. Navigate to "Keys and Tokens"
# 4. Generate a Bearer Token (v2 API)
# 5. Copy the Bearer Token and paste it below
# 6. Copy this file to .env.local and update the token

TWITTER_BEARER_TOKEN=your_bearer_token_here

# Note: Make sure your Bearer Token has read-only permissions
# The token should start with 'AAAA'
